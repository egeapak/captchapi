{
  "name": "captchapi",
  "version": "2.0.0",
  "description": "High-performance CAPTCHA generation and validation library for Node.js, powered by Rust",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/egeapak/captchapi"
  },
  "keywords": [
    "captcha",
    "security",
    "validation",
    "image",
    "rust",
    "native",
    "high-performance"
  ],
  "author": "egeapak",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node dist/cjs/index.js"
  },
  "dependencies": {
    "@captchapi/core": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@captchapi/core": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@captchapi/core": {
      "optional": false
    }
  }
}
