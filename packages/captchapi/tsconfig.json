{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    // Explicit since TypeScript 7: rootDir is no longer inferred from the common
    // source directory, and every build config here extends this one.
    "rootDir": "./src",
    // Also explicit since TypeScript 7, which no longer pulls every package in
    // node_modules/@types into the global scope. This source uses `require`,
    // `process`, `console` and the `NodeJS` namespace.
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
