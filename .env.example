# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database
DATABASE_URL=sqlite:./data/captchapi.db
DATABASE_MAX_CONNECTIONS=5

# Security
# IMPORTANT: Change these to random strings in production
API_KEY_SALT=change-this-to-a-random-salt-in-production
MASTER_API_KEY=change-this-to-a-secure-master-key-in-production
# Key used to hash CAPTCHA solutions before storing them (min 16 chars).
# Defaults to API_KEY_SALT. Set a dedicated value to keep the two uses separate.
# Changing it invalidates sessions created before the restart.
# SOLUTION_HASH_SECRET=change-this-to-a-random-secret-in-production
# Key used to encrypt stored CAPTCHA images (min 16 chars).
# Defaults to API_KEY_SALT. Changing it makes existing stored images unreadable.
# IMAGE_ENCRYPTION_SECRET=change-this-to-a-random-secret-in-production

# CAPTCHA Defaults
DEFAULT_SESSION_TTL_SECONDS=300
MAX_SESSION_TTL_SECONDS=3600
MAX_VALIDATION_ATTEMPTS=3
CAPTCHA_COMPRESSION=40

# Rate Limiting (tower_governor with GCRA algorithm)
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST_SIZE=10
# Set to true when behind a reverse proxy (nginx, Cloudflare, etc.)
# This reads client IP from X-Forwarded-For, X-Real-IP, or Forwarded headers
# WARNING: Only enable if you trust your proxy - clients can spoof headers otherwise
RATE_LIMIT_REVERSE_PROXY=false

# Background Tasks
CLEANUP_INTERVAL_SECONDS=60

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=captchapi

# Logging
RUST_LOG=captchapi=debug,tower_http=debug

# Admin API
# Set to false to disable PATCH /api/v1/admin/config (reload and reads keep working)
ADMIN_CONFIG_WRITE=true

# Process ID file, so `captchapi reload` can find a running server
PID_FILE=./data/captchapi.pid
