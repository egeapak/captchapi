{
  "name": "@captchapi/core",
  "version": "2.0.0",
  "description": "High-performance CAPTCHA generation and validation library for Node.js, powered by Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/egeapak/captchapi"
  },
  "keywords": [
    "captcha",
    "rust",
    "napi",
    "native",
    "security",
    "validation",
    "image"
  ],
  "author": "egeapak",
  "license": "Apache-2.0",
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "name": "captchapi",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node test/index.js",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "@captchapi/core-win32-x64-msvc": "2.0.0",
    "@captchapi/core-darwin-x64": "2.0.0",
    "@captchapi/core-darwin-arm64": "2.0.0",
    "@captchapi/core-linux-x64-gnu": "2.0.0",
    "@captchapi/core-linux-arm64-gnu": "2.0.0",
    "@captchapi/core-linux-x64-musl": "2.0.0",
    "@captchapi/core-linux-arm64-musl": "2.0.0"
  }
}
