# ============================================================
# CaptchAPI - scratch build (experimental)
# ============================================================
# Same expectation as Dockerfile.static: a pre-built musl binary at
# docker/bin/captchapi-musl.
#
# This exists to answer "how small can it get". `distroless/static` is 3.00 MB
# unpacked, of which tzdata alone is 2.42 MB — dead weight for a service that
# stores unix timestamps. Starting from scratch drops all of it.
#
# WHAT YOU GIVE UP, and why each line below exists:
#
#   * No shell, no mkdir, no chown. `/data` has to be staged in a builder and
#     copied in with ownership already set.
#   * No /etc/passwd or /etc/group. `USER nonroot` cannot resolve a name, so
#     the numeric UID:GID is mandatory. The files are copied anyway so that
#     anything calling getpwuid() gets an answer instead of an error.
#   * No CA bundle by default, so one is copied in below. The service pushes
#     both traces and metrics over OTLP; against an https collector the
#     exporter cannot verify TLS without it. The stock endpoint is
#     `http://localhost:4318` — a plain-HTTP sidecar, which needs no certs at
#     all — but a remote collector is common enough that shipping them beats
#     debugging a TLS error inside a container with no shell.
#   * No /tmp. Nothing in the service writes there today, but a dependency
#     that wants a scratch file would fail with ENOENT rather than EACCES,
#     which is a confusing way to find out.
#
# The binary itself needs none of this: it is static-pie linked with no libc
# dependency, so it runs on an empty filesystem.

FROM alpine:latest AS staging
# No `apk add` here on purpose: the alpine base already ships
# ca-certificates-bundle, and installing would need network the build may not
# have. Staging from the base keeps this buildable offline.
RUN mkdir -p /staged/data && chown 65532:65532 /staged/data && \
    mkdir -p /staged/tmp && chmod 1777 /staged/tmp && \
    printf 'nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin\n' > /staged/passwd && \
    printf 'nonroot:x:65532:\n' > /staged/group

FROM scratch

WORKDIR /app

COPY --from=staging --chown=65532:65532 /staged/data /data
COPY --from=staging /staged/tmp /tmp
COPY --from=staging /staged/passwd /etc/passwd
COPY --from=staging /staged/group /etc/group

# Needed by the OTLP exporter when the collector is reached over https.
COPY --from=staging /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --chown=65532:65532 migrations /app/migrations
COPY --chown=65532:65532 docker/bin/captchapi-musl /app/captchapi

ENV DATABASE_URL=sqlite:/data/captchapi.db
ENV PID_FILE=/data/captchapi.pid

EXPOSE 3000

# Numeric, because there is no name resolution here.
USER 65532:65532

ENTRYPOINT ["/app/captchapi"]
