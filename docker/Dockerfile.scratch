# ============================================================
# CaptchAPI - scratch build (multi-architecture)
# ============================================================
# Published under `scratch-` prefixed tags: `scratch-latest`, `scratch-1.2.3`,
# and so on. The bare tags (`latest`, `1.2.3`) are Dockerfile.multiarch, the
# distroless image, which remains the default. Both are built for
# linux/amd64 + linux/arm64 by .github/workflows/release.yml.
#
# Expects pre-built musl binaries at:
#   - docker/bin/captchapi-amd64 (for linux/amd64)
#   - docker/bin/captchapi-arm64 (for linux/arm64)
#
# This used to take `docker/bin/captchapi-musl`, which pinned it to whichever
# architecture happened to be staged; TARGETARCH is what lets one
# `docker buildx build --platform linux/amd64,linux/arm64` produce both.
#
# `distroless/static` is 3.00 MB unpacked, of which tzdata alone is 2.42 MB —
# dead weight for a service that stores unix timestamps. Starting from scratch
# drops all of it: 22% off the pull and 40% off unpacked.
#
# WHAT YOU GIVE UP by being on scratch, and why each line below exists. Every
# one of these is hand-staged here, which is precisely why release.yml runs the
# image and serves a CAPTCHA from it before publishing — there is no shell in
# here to work out afterwards which one was forgotten:
#
#   * No shell, no mkdir, no chown. `/data` has to be staged in a builder and
#     copied in with ownership already set.
#   * No /etc/passwd or /etc/group. `USER nonroot` cannot resolve a name, so
#     the numeric UID:GID is mandatory. The files are copied anyway so that
#     anything calling getpwuid() gets an answer instead of an error.
#   * No CA bundle by default, so one is copied in below. The service pushes
#     both traces and metrics over OTLP; against an https collector the
#     exporter cannot verify TLS without it. The stock endpoint is
#     `http://localhost:4318` — a plain-HTTP sidecar, which needs no certs at
#     all — but a remote collector is common enough that shipping them beats
#     debugging a TLS error inside a container with no shell.
#   * No /tmp. Nothing in the service writes there today, but a dependency
#     that wants a scratch file would fail with ENOENT rather than EACCES,
#     which is a confusing way to find out.
#
# The binary itself needs none of this: it is static-pie linked with no libc
# dependency, so it runs on an empty filesystem.

# `--platform=$BUILDPLATFORM` pins this stage to the machine doing the building. Everything it
# produces — a directory with an owner, two lines of passwd/group text, a PEM bundle — is
# architecture-independent, so building it for the *target* would mean emulating aarch64 under
# qemu to run `mkdir`. That is slow, and it makes the build depend on binfmt being registered
# on the runner for no gain.
FROM --platform=$BUILDPLATFORM alpine:latest AS staging
# No `apk add` here on purpose: the alpine base already ships
# ca-certificates-bundle, and installing would need network the build may not
# have. Staging from the base keeps this buildable offline.
RUN mkdir -p /staged/data && chown 65532:65532 /staged/data && \
    mkdir -p /staged/tmp && chmod 1777 /staged/tmp && \
    printf 'nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin\n' > /staged/passwd && \
    printf 'nonroot:x:65532:\n' > /staged/group

FROM scratch

# Set automatically by buildx to "amd64" or "arm64".
ARG TARGETARCH

WORKDIR /app

COPY --from=staging --chown=65532:65532 /staged/data /data
COPY --from=staging /staged/tmp /tmp
COPY --from=staging /staged/passwd /etc/passwd
COPY --from=staging /staged/group /etc/group

# Needed by the OTLP exporter when the collector is reached over https.
COPY --from=staging /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --chown=65532:65532 migrations /app/migrations
COPY --chown=65532:65532 docker/bin/captchapi-${TARGETARCH} /app/captchapi

ENV DATABASE_URL=sqlite:/data/captchapi.db
ENV PID_FILE=/data/captchapi.pid

# The distroless base sets this; scratch inherits nothing, so set it explicitly. The bundle is
# already at the compiled-in default path above, but a dependency that consults only the
# environment variable would otherwise find no roots at all.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

EXPOSE 3000

# Numeric, because there is no name resolution here.
USER 65532:65532

# Same labels as Dockerfile.multiarch. `image.source` is what links the published package to
# this repository on ghcr.io; without it the package page has no route back to the source.
LABEL org.opencontainers.image.source="https://github.com/egeapak/captchapi"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.title="CaptchAPI"
LABEL org.opencontainers.image.description="REST API for CAPTCHA challenges (scratch variant)"

ENTRYPOINT ["/app/captchapi"]
