meta {
  name: Patch Config - Success
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/api/v1/admin/config
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{master_key}}
}

body {
  {
    "captcha_compression": 75
  }
}

tests {
  test("should return 200", function() {
    expect(res.status).to.equal(200);
  });

  test("should apply the value", function() {
    expect(res.body.config.captcha_compression.value).to.equal("75");
  });

  test("should record the override", function() {
    expect(res.body.overrides).to.include("captcha_compression");
  });
}

docs {
  Requires a server that was NOT started with an explicit CAPTCHA_COMPRESSION on the command
  line or in the process environment. Those two layers pin a field against runtime changes,
  so this request would return 409 config_pinned instead of 200 — correctly, but the failure
  reads like a regression if you do not know why.

  An `.env` file is fine, and is what ci.yml uses: files can be edited and re-read, so a
  value from one stays patchable.
}
