meta {
  name: Cleanup Expired Sessions
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/admin/cleanup
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{master_key}}
}

tests {
  test("should return 200 OK", function() {
    expect(res.status).to.equal(200);
  });

  test("should return sessions_deleted count", function() {
    expect(res.body.sessions_deleted).to.be.a("number");
    expect(res.body.sessions_deleted).to.be.at.least(0);
  });

  test("should return message", function() {
    expect(res.body.message).to.be.a("string");
    expect(res.body.message).to.not.be.empty;
  });
}

docs {
  # Cleanup Expired Sessions

  This endpoint triggers a manual cleanup of expired sessions from the database.

  ## Authentication
  Requires the master API key via `X-Master-Key` header.

  ## Response
  Returns the number of sessions deleted and a status message.

  ## Rate Limiting
  This endpoint is NOT rate limited as it's an admin operation.
}
