{
  "name": "@captchapi/core",
  "version": "0.1.2",
  "description": "High-performance CAPTCHA generation and validation library for Node.js, powered by Rust",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/captchapi/captchapi"
  },
  "keywords": [
    "captcha",
    "rust",
    "napi",
    "native",
    "security",
    "validation",
    "image"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "name": "captchapi",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features napi",
    "build:debug": "napi build --platform --features napi",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node test/index.js",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "@captchapi/core-win32-x64-msvc": "0.1.2",
    "@captchapi/core-darwin-x64": "0.1.2",
    "@captchapi/core-darwin-arm64": "0.1.2",
    "@captchapi/core-linux-x64-gnu": "0.1.2",
    "@captchapi/core-linux-arm64-gnu": "0.1.2",
    "@captchapi/core-linux-x64-musl": "0.1.2",
    "@captchapi/core-linux-arm64-musl": "0.1.2"
  }
}
